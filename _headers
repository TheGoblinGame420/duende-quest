# Cabeceras de los archivos estaticos (Workers Static Assets las lee de aqui).
# Los estaticos NO pasan por worker.js (run_worker_first solo
# cubre /api/* y /mmo/ws en wrangler.toml), asi que estas son las
# cabeceras que reciben index.html, mundo/, mmo/, assets/... Si se toca algo
# aqui, revisar tambien worker.js (lo que el Worker sirve a mano).
# OJO: sin frame-ancestors de Telegram la Mini App no carga en web.telegram.org.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: frame-ancestors 'self' https://web.telegram.org https://*.telegram.org; object-src 'none'; base-uri 'self'

# TON Connect: las wallets externas leen el manifiesto desde su propio origen.
/tonconnect-manifest.json
  Access-Control-Allow-Origin: *

# PWA: el service worker se revisa siempre y controla todo el sitio.
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

# Imagenes y audio sin hash en el nombre: 1 dia de cache (ver worker.js).
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600

/audio/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600

# JS de ORIGINS (mundo/js) y CLASSIC (mmo/js): los HTML los piden con ?v=N y
# el flujo de publicacion sube ese ?v= en cada version, asi que una URL nueva
# salta la cache. Antes iban con max-age=0 y el movil revalidaba ~20 modulos
# uno a uno antes de jugar (lento con datos moviles desde Meta Ads).
# NO es "immutable" a proposito: hay imports internos sin ?v= en el codigo
# (mundo/js/abismo.js -> '/mmo/js/abismo3d.js' y mmo/js/mundo3d.js ->
# './abismo3d.js'; los corrige el importmap de mundo/index.html, pero si un
# dia falta, el jugador quedaria con un JS viejo una semana). Por eso 1 hora
# fresca + 1 dia sirviendo la copia mientras se revalida en segundo plano.
# Si todos los imports llevan ?v=, se puede subir a
# "public, max-age=604800, immutable". Ninguna otra regla de este archivo pone
# Cache-Control en estas rutas (no se duplica la cabecera).
/mundo/js/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/mmo/js/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
